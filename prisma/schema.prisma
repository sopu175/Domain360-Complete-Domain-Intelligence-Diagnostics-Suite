generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScanHistory {
  id           String   @id @default(cuid())
  domain       String
  score        Int?
  grade        String?
  summaryJson  String?
  findingsJson String?
  createdAt    DateTime @default(now())

  @@index([domain])
  @@index([createdAt])
}

model SavedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  label     String?
  createdAt DateTime @default(now())
}